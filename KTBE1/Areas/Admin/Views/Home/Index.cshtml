@model IEnumerable<KTBE1.Models.Product>

@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewBag.Title = "Cửa hàng quần áo";
}

<h2 class="mt-4 mb-3">Thời trang mới</h2>

<div class="row">
    @foreach (var p in Model)
    {
        <div class="col-md-4 col-lg-3 mb-4">
            <div class="card h-100">
                @if (!string.IsNullOrEmpty(p.ProductImage))
                {
                    <img src="@Url.Content("~/Content/images/" + p.ProductImage)"
                         class="card-img-top"
                         alt="@p.ProductName"
                         style="height:260px; object-fit:cover;" />
                }

                <div class="card-body">
                    <h5 class="card-title">@p.ProductName</h5>
                    <p class="text-muted">@p.Category.CategoryName</p>
                    <p>@p.ProductDecription</p>
                    <strong class="text-danger">@p.ProductPrice.ToString("N0") đ</strong>
                </div>

                <div class="card-footer bg-white">
                    <a class="btn btn-outline-primary"
                       href="@Url.Action("Details", "Product", new { id = p.ProductID })">
                        Xem chi tiết
                    </a>
                </div>
            </div>
        </div>
    }
</div>