@model KTBE1.Areas.Admin.Data.OrderListViewModel
@using System.Linq
@using KTBE1.Models
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Danh sách đơn hàng";
    Func<string, string, string> next = (a, b) => Model.Sort == a ? b : a;
}

<h4 class="mt-3 mb-3">DANH SÁCH ĐƠN HÀNG</h4>

<form method="get" action="@Url.Action("Index", "Orders", new { area = "Admin" })" class="row g-2 mb-3">
    <input type="hidden" name="sort" value="@Model.Sort" />
    <div class="col-md-3">
        <label class="form-label">Tên khách hàng</label>
        <input type="text" name="customerName" class="form-control" value="@Model.CustomerName" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Trạng thái thanh toán</label>
        <select name="paymentStatus" class="form-select">
            <option value="">-- Tất cả --</option>
            @foreach (var s in OrderStatus.All)
            {
                <option value="@s" @(Model.PaymentStatus == s ? "selected" : "")>@s</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Ngày đặt hàng</label>
        <input type="date" name="orderDate" class="form-control" value="@Model.OrderDateText" />
    </div>
    <div class="col-md-3 d-flex align-items-end">
        <button type="submit" class="btn btn-primary">Tìm kiếm</button>
    </div>
</form>

@if (Model.Orders == null || Model.Orders.Count == 0)
{
    <div class="alert alert-secondary text-center fw-bold">KHÔNG CÓ</div>
}
else
{
    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>Mã đơn</th>
                <th><a class="text-white" href="@Url.Action("Index", new { customerName = Model.CustomerName, paymentStatus = Model.PaymentStatus, orderDate = Model.OrderDateText, sort = next("date_desc", "date_asc"), page = 1 })">Ngày đặt hàng</a></th>
                <th><a class="text-white" href="@Url.Action("Index", new { customerName = Model.CustomerName, paymentStatus = Model.PaymentStatus, orderDate = Model.OrderDateText, sort = next("name_asc", "name_desc"), page = 1 })">Tên khách hàng</a></th>
                <th>Địa chỉ giao hàng</th>
                <th><a class="text-white" href="@Url.Action("Index", new { customerName = Model.CustomerName, paymentStatus = Model.PaymentStatus, orderDate = Model.OrderDateText, sort = next("total_asc", "total_desc"), page = 1 })">Tổng tiền</a></th>
                <th>Trạng thái thanh toán</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var o in Model.Orders)
            {
                <tr>
                    <td>#@o.OrderID</td>
                    <td>@o.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@o.Customer.CustomerName</td>
                    <td>@o.AddressDelivery</td>
                    <td>@o.TotalAmount.ToString("N0") đ</td>
                    <td><span class="@("badge bg-" + OrderStatus.BadgeClass(o.PaymentStatus))">@o.PaymentStatus</span></td>
                    <td>@Html.ActionLink("Chi tiết đơn hàng", "DetailedOrder", new { id = o.OrderID })</td>
                </tr>
            }
        </tbody>
    </table>

    if (Model.TotalPages > 1)
    {
        <nav>
            <ul class="pagination">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="@("page-item" + (i == Model.Page ? " active" : ""))">
                        <a class="page-link" href="@Url.Action("Index", new { customerName = Model.CustomerName, paymentStatus = Model.PaymentStatus, orderDate = Model.OrderDateText, sort = Model.Sort, page = i })">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
}