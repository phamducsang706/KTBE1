@model KTBE1.Models.Order
@using KTBE1.Models
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Cập nhật trạng thái đơn hàng";
}

<h4 class="mt-3 mb-3">CẬP NHẬT TRẠNG THÁI ĐƠN HÀNG #@Model.OrderID</h4>

<p>Khách hàng: <strong>@Model.Customer.CustomerName</strong> &middot; Tổng tiền: <strong>@Model.TotalAmount.ToString("N0") đ</strong></p>

@using (Html.BeginForm("UpdateStatus", "Orders", new { area = "Admin", id = Model.OrderID }, FormMethod.Post))
{
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="mb-3" style="max-width:320px;">
        <label class="form-label">Trạng thái</label>
        <select name="paymentStatus" class="form-select">
            @foreach (var s in OrderStatus.All)
            {
                <option value="@s" @(Model.PaymentStatus == s ? "selected" : "")>@s</option>
            }
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Lưu</button>
    <a class="btn btn-outline-secondary" href="@Url.Action("DetailedOrder", "Orders", new { id = Model.OrderID })">Hủy</a>
}