@model KTBE1.Models.Order
@using KTBE1.Models
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Chi tiết đơn hàng";
}

<h4 class="mt-3 mb-3">CHI TIẾT ĐƠN HÀNG</h4>

@if (TempData["Msg"] != null)
{
    <div class="alert alert-success">@TempData["Msg"]</div>
}

<div class="row">
    <div class="col-md-4">
        <table class="table table-sm table-borderless">
            <tr><th>Mã đơn hàng</th><td>#@Model.OrderID</td></tr>
            <tr><th>Ngày đặt hàng</th><td>@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</td></tr>
            <tr><th>Khách hàng</th><td>@Model.Customer.CustomerName</td></tr>
            <tr><th>Điện thoại</th><td>@Model.Customer.CustomerPhone</td></tr>
            <tr><th>Email</th><td>@Model.Customer.CustomerEmail</td></tr>
            <tr><th>Địa chỉ giao hàng</th><td>@Model.AddressDelivery</td></tr>
            <tr><th>Trạng thái</th><td><span class="@("badge bg-" + OrderStatus.BadgeClass(Model.PaymentStatus))">@Model.PaymentStatus</span></td></tr>
            <tr><th>Tổng tiền</th><td class="text-danger fw-bold">@Model.TotalAmount.ToString("N0") đ</td></tr>
        </table>
        <a class="btn btn-primary" href="@Url.Action("UpdateStatus", "Orders", new { id = Model.OrderID })">Cập nhật trạng thái</a>
        <a class="btn btn-outline-secondary" href="@Url.Action("Index", "Orders")">Quay lại danh sách</a>
    </div>
    <div class="col-md-8">
        <table class="table table-bordered align-middle">
            <thead class="table-dark">
                <tr><th>Sản phẩm</th><th>Số lượng</th><th>Đơn giá</th><th>Thành tiền</th></tr>
            </thead>
            <tbody>
                @foreach (var d in Model.OrderDetail)
                {
                    <tr>
                        <td>
                            <img src="@Url.Content("~/Content/images/" + d.Product.ProductImage)" alt="" style="width:50px;height:70px;object-fit:cover;" onerror="this.style.visibility='hidden'" />
                            <span class="ms-2">@d.Product.ProductName</span>
                        </td>
                        <td>@d.Quantity</td>
                        <td>@d.UnitPrice.ToString("N0") đ</td>
                        <td>@((d.Quantity * d.UnitPrice).ToString("N0")) đ</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>