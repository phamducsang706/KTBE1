<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Admin</title>
    @Styles.Render("~/Content/css")
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-dark" style="background:#212529;">
        <div class="container">
            @Html.ActionLink("ADMIN", "Index", "Home", new { area = "Admin" }, new { @class = "navbar-brand" })
            <ul class="navbar-nav me-auto">
                <li class="nav-item">@Html.ActionLink("Trang chủ", "Index", "Home", new { area = "Admin" }, new { @class = "nav-link" })</li>
                <li class="nav-item">@Html.ActionLink("Đơn hàng", "Index", "Orders", new { area = "Admin" }, new { @class = "nav-link" })</li>
            </ul>
            <span class="navbar-text me-3">@(Session["Username"] as string)</span>
            @Html.ActionLink("Đăng xuất", "Logout", "Account", new { area = "" }, new { @class = "btn btn-sm btn-outline-light" })
        </div>
    </nav>

    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - Trang quản trị (Admin Layout)</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    <script src="@Url.Content("~/Scripts/bootstrap.bundle.min.js")"></script>
    @RenderSection("scripts", required: false)
</body>
</html>